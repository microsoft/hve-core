# Node package manager configuration
#
# This directory has its own package.json, so npm resolves "project" config
# from here and does not read the repository-root .npmrc. Registry and security
# settings must be repeated here to keep the committed lockfile publicly
# sourced and to keep install behavior aligned with the repository root.

# Keep committed lockfiles reproducible for OSS contributors.
registry=https://registry.npmjs.org/
replace-registry-host=always

# Save exact versions in package.json
save-exact=true

# Use package-lock.json for reproducible installs
package-lock=true

# Do not run lifecycle scripts (preinstall/install/postinstall) from
# dependencies. This root installs a screen-reader driver whose dependency
# chain writes to the registry during install when scripts are permitted.
ignore-scripts=true

# Audit packages for security vulnerabilities on install
audit=true
audit-level=moderate
