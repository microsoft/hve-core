{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/hve-core/accessibility/schema-validation-report.schema.json",
  "title": "Accessibility schema validation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "documents"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "const": "valid" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "schema", "status"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "schema": { "type": "string", "minLength": 1 },
          "status": { "const": "valid" }
        }
      }
    }
  }
}
