{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/hve-core/ns/accessibility/qualified-human-result.schema.json",
  "title": "Qualified-human accessibility result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "supplementId", "campaignId", "cellId", "requirementId", "journeyId", "state", "fixtureId", "method", "sourceRevision", "buildDigest", "configDigest", "reviewerId", "qualificationRecordId", "qualificationRecordDigest", "approvalRecordId", "approvalRecordDigest", "observedAt", "status", "observedSummary", "privacy", "digest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "supplementId": { "$ref": "#/$defs/id" },
    "campaignId": { "$ref": "#/$defs/id" },
    "cellId": { "$ref": "#/$defs/id" },
    "requirementId": { "$ref": "#/$defs/id" },
    "journeyId": { "$ref": "#/$defs/id" },
    "state": { "type": "string", "minLength": 1 },
    "fixtureId": { "$ref": "#/$defs/id" },
    "method": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "buildDigest": { "$ref": "#/$defs/digest" },
    "configDigest": { "$ref": "#/$defs/digest" },
    "reviewerId": { "$ref": "#/$defs/id" },
    "qualificationRecordId": { "$ref": "#/$defs/id" },
    "qualificationRecordDigest": { "$ref": "#/$defs/digest" },
    "approvalRecordId": { "$ref": "#/$defs/id" },
    "approvalRecordDigest": { "$ref": "#/$defs/digest" },
    "observedAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "status": { "enum": ["PASS", "FAIL", "CANT_TELL", "NOT_ASSESSED", "INAPPLICABLE"] },
    "observedSummary": { "type": "string", "minLength": 1 },
    "limitation": { "type": "string", "minLength": 1 },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "redacted", "personalDataPresent"],
      "properties": {
        "classification": { "enum": ["public", "internal", "restricted"] },
        "redacted": { "const": true },
        "personalDataPresent": { "type": "boolean" },
        "authorityReference": { "type": "string", "minLength": 1 }
      }
    },
    "artifactDigests": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
    "reentryTrigger": { "type": "string", "minLength": 1 },
    "supersedesSupplementId": { "$ref": "#/$defs/id" },
    "previousSupplementDigest": { "$ref": "#/$defs/digest" },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "qualificationApprovalRegistryInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generatedAt", "records", "digest"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/registryRecord" } },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "registryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "reviewerId", "kind", "status", "scopes", "verifiedBy", "verifiedAt", "validUntil", "digest"],
      "properties": {
        "recordId": { "$ref": "#/$defs/id" },
        "reviewerId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["qualification", "approval"] },
        "status": { "enum": ["current", "pending", "rejected", "expired", "revoked"] },
        "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "verifiedBy": { "$ref": "#/$defs/id" },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}