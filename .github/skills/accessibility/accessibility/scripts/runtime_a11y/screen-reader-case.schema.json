{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/hve-core/accessibility/screen-reader-case.schema.json",
  "title": "Product-neutral screen-reader case catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "catalogId": { "$ref": "#/$defs/id" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "stringList": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "outcomeClass", "requiredCapabilities", "targetRefs", "states", "privacyClass", "cadence", "promotion"],
      "properties": {
        "caseId": { "$ref": "#/$defs/id" },
        "outcomeClass": { "enum": ["interaction", "announcement", "structure", "adaptive", "integrity", "presentation"] },
        "requiredCapabilities": { "$ref": "#/$defs/stringList" },
        "targetRefs": { "$ref": "#/$defs/stringList" },
        "states": { "$ref": "#/$defs/stringList" },
        "privacyClass": { "enum": ["ordinary", "restricted"] },
        "cadence": { "enum": ["per-change", "advisory-manual", "both"] },
        "promotion": { "enum": ["deterministic", "candidate-until-calibrated", "integrity-gate"] }
      }
    }
  }
}
