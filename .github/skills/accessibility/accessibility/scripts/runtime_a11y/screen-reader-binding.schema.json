{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microsoft.github.io/hve-core/accessibility/screen-reader-binding.schema.json",
  "title": "Downstream screen-reader case binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bindingProfileId", "catalogId", "catalogDigest", "product", "routes", "targets", "caseBindings"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "bindingProfileId": { "$ref": "#/$defs/id" },
    "catalogId": { "$ref": "#/$defs/id" },
    "catalogDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "surfaceProfiles"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "surfaceProfiles": { "type": "array", "uniqueItems": true, "items": { "enum": ["document", "presentation"] } }
      }
    },
    "routes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^/" } },
    "targets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/target" } },
    "caseBindings": { "type": "object", "additionalProperties": { "$ref": "#/$defs/caseBinding" } },
    "bundleDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadataSource", "servedRouteTemplate"],
      "properties": {
        "metadataSource": { "type": "string", "minLength": 1 },
        "servedRouteTemplate": { "type": "string", "pattern": "\\{slug\\}" },
        "parityStages": { "type": "array", "uniqueItems": true, "items": { "enum": ["source", "folder-build", "committed-bundle", "served-copy", "runtime"] } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeRef", "selector"],
      "properties": {
        "routeRef": { "$ref": "#/$defs/id" },
        "selector": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "caseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRefs"],
      "properties": {
        "targetRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "states": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "representativeAt": { "type": "boolean" },
        "executions": { "type": "array", "items": { "$ref": "#/$defs/execution" } }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "surfaceId", "state", "trigger", "commands", "assertions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "pattern": "^/" },
        "surfaceId": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/id" },
        "captureMode": { "enum": ["single", "clear-and-capture", "action"] },
        "triggerAfterDriverStart": { "type": "boolean" },
        "trigger": { "type": "object" },
        "triggerSequence": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "object" } },
        "commands": { "type": "array", "items": { "type": "object" } },
        "assertions": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    }
  }
}
