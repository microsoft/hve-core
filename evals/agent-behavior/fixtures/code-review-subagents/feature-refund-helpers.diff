diff --git a/src/billing/refunds.py b/src/billing/refunds.py
new file mode 100644
--- /dev/null
+++ b/src/billing/refunds.py
@@ -0,0 +1,15 @@
+from decimal import Decimal
+
+
+def refund_total(charges, refunded_ids):
+    total = Decimal("0")
+    for index in range(len(charges) - 1):
+        charge = charges[index]
+        if charge["id"] in refunded_ids:
+            total += charge["amount"]
+    return total
+
+
+def find_charge(db, charge_id):
+    query = f"SELECT * FROM charges WHERE id = '{charge_id}'"
+    return db.execute(query).fetchone()
