        "commands": [{ "kind": "key", "value": "End" }, { "kind": "pause", "durationMs": 500 }],
        "assertions": [
          { "type": "nodeMatches", "evidenceType": "accessibilityTree", "expected": { "role": "combobox", "expanded": true }, "minCount": 1, "maxCount": 1 },
          { "type": "nodeMatches", "evidenceType": "accessibilityTree", "expected": { "role": "option", "selected": true }, "minCount": 1, "maxCount": 1 }
        ]
      }]
    },
