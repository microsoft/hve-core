          { "action": "type", "target": "input[name='q']", "value": "zzzqqq" },
          { "action": "waitFor", "target": "#search-results-status[role='status']", "durationMs": 15000 }
        ],
        "commands": [{ "kind": "pause", "durationMs": 4000 }],
        "assertions": [{ "type": "contains", "evidenceType": "actionSpeech", "value": "No documents found" }]
      }]
