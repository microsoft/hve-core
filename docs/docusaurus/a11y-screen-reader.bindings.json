      "targetRefs": ["search.status"],
      "representativeAt": true,
      "executions": [{
        "id": "hve-search-status-results", "title": "Search results status announcement",
        "route": "/hve-core/search/?q=agent", "surfaceId": "search-results", "state": "results",
        "captureMode": "action", "triggerAfterDriverStart": true,
        "trigger": { "action": "type", "target": "input[name='q']", "value": "agent" },
        "triggerSequence": [
          { "action": "click", "target": "input[name='q']" },
          { "action": "type", "target": "input[name='q']", "value": "agent" },
          { "action": "waitFor", "target": "#search-results-status[role='status']", "durationMs": 15000 }
        ],
        "commands": [{ "kind": "pause", "durationMs": 4000 }],
        "assertions": [{ "type": "matches", "evidenceType": "actionSpeech", "value": "[0-9]+ documents? found" }]
      }, {
