{
  "$schema": "../../.github/skills/accessibility/accessibility/scripts/runtime_a11y/screen-reader-binding.schema.json",
  "schemaVersion": "1.0.0",
  "bindingProfileId": "hve-core-site",
  "catalogId": "hve-screen-reader-cases",
  "catalogDigest": "sha256:30cd17362be7fe77e44a2aa254a34fd74771c16ede8e2affc3e94eb1790350d3",
  "product": { "name": "HVE Core public site", "surfaceProfiles": ["document", "presentation"] },
  "routes": {
    "home": "/hve-core/", "docs": "/hve-core/docs/", "search": "/hve-core/search/", "integrity": "/hve-core/accessibility/screen-reader-calibration.html",
    "slides": "/hve-core/slides/", "accessibility": "/hve-core/accessibility/",
    "vpat": "/hve-core/accessibility/vpat/", "deck": "/hve-core/slides/{slug}.html"
  },
  "targets": {
    "positiveControl.checkbox": { "routeRef": "integrity", "selector": "[data-a11y-positive-control=checkbox]", "role": "checkbox", "name": "Accept terms" },
    "positiveControl.headings": { "routeRef": "integrity", "selector": "h1, h2" },
    "nav.documentation": { "routeRef": "home", "selector": "a[href$='/docs/']", "role": "link", "name": "Documentation" },
    "nav.topics": { "routeRef": "home", "selector": "[aria-controls='topics-menu']" },
    "nav.topics.firstItem": { "routeRef": "home", "selector": "#topics-menu a:first-of-type" },
    "main": { "routeRef": "docs", "selector": "main" },
    "home.banner": { "routeRef": "home", "selector": "header[role='banner']" },
    "home.install": { "routeRef": "home", "selector": "a[href*='install']" },
    "home.collections": { "routeRef": "home", "selector": "a[href*='/docs/getting-started/packages']" },
    "home.deepDive": { "routeRef": "home", "selector": "[aria-labelledby*='deep']" },
    "home.collectionsGroup": { "routeRef": "home", "selector": "[aria-labelledby='packages-title']" },
    "search.input": { "routeRef": "home", "selector": "input.navbar__search-input" },
    "search.shortcut": { "routeRef": "home", "selector": "[id*='search'][id*='shortcut']" },
    "search.option": { "routeRef": "home", "selector": "[role='option']" },
    "search.seeAll": { "routeRef": "home", "selector": "a[href*='/search/']" },
    "search.clear": { "routeRef": "home", "selector": "button[aria-label*='Clear']" },
    "search.status": { "routeRef": "search", "selector": "#search-results-status[role='status']" },
    "search.pageInput": { "routeRef": "search", "selector": "input[name='q']" },
    "search.regionHeading": { "routeRef": "search", "selector": "h1" },
    "docs.table": { "routeRef": "docs", "selector": "table[aria-labelledby='when-to-use']" },
    "docs.heading": { "routeRef": "docs", "selector": "h1, h2, h3, h4, h5" },
    "docs.diagram": { "routeRef": "docs", "selector": "svg[role~='graphics-document']" },
    "docs.footerGroup": { "routeRef": "docs", "selector": "footer" },
    "docs.tocGroup": { "routeRef": "docs", "selector": ".table-of-contents" },
    "docs.sidebar": { "routeRef": "docs", "selector": "nav[aria-label*='sidebar'], .theme-doc-sidebar-menu" },
    "presentation.root": { "routeRef": "deck", "selector": "main.slides" },
    "presentation.currentSlide": { "routeRef": "deck", "selector": ".slides > section.present" },
    "presentation.inactiveSlides": { "routeRef": "deck", "selector": ".slides > section:not(.present)" },
    "presentation.previous": { "routeRef": "deck", "selector": "#previous-slide" },
    "presentation.next": { "routeRef": "deck", "selector": "#next-slide" },
    "presentation.index": { "routeRef": "deck", "selector": "#overview-button" },
    "presentation.readingView": { "routeRef": "deck", "selector": "#reading-button" },
    "presentation.motion": { "routeRef": "deck", "selector": "#motion-button" },
    "presentation.fullscreen": { "routeRef": "deck", "selector": "#fullscreen-button" },
    "presentation.announcement": { "routeRef": "deck", "selector": "#announcement" },
    "presentation.dialog": { "routeRef": "deck", "selector": "#detail-dialog" },
    "presentation.notes": { "routeRef": "deck", "selector": "[data-dialog='notes']" },
    "presentation.sources": { "routeRef": "deck", "selector": "[data-dialog='sources']" },
    "presentation.help": { "routeRef": "deck", "selector": "[data-dialog='help']" },
    "presentation.walkthrough": { "routeRef": "deck", "selector": "[data-demo]" },
    "presentation.diagram": { "routeRef": "deck", "selector": ".graph-description, svg[role~='graphics-document']" }
  },
  "caseBindings": {
    "SR-INTEGRITY-001": {
      "targetRefs": ["positiveControl.checkbox", "positiveControl.headings"],
      "representativeAt": true,
      "executions": [{
        "id": "screen-reader-integrity", "title": "Named checkbox and heading integrity",
        "route": "/hve-core/accessibility/screen-reader-calibration.html", "surfaceId": "screen-reader-integrity", "state": "initial",
        "captureMode": "action", "triggerAfterDriverStart": true,
        "trigger": { "action": "click", "target": "[data-a11y-positive-control=checkbox]" },
        "commands": [{ "kind": "pause", "durationMs": 500 }],
        "assertions": [
          { "type": "contains", "evidenceType": "actionSpeech", "value": "checked" },
          { "type": "nodeMatches", "evidenceType": "accessibilityTree", "expected": { "role": "checkbox", "name": "Accept terms", "checked": true }, "minCount": 1, "maxCount": 1 },
          { "type": "nodeMatches", "evidenceType": "accessibilityTree", "expected": { "role": "heading" }, "minCount": 2 }
        ]
      }]
    },
    "HVE-NVDA-001": {
      "targetRefs": ["nav.documentation", "main"],
      "executions": [{
        "id": "hve-documentation-navigation", "title": "Documentation navigation reaches main content",
        "route": "/hve-core/", "surfaceId": "homepage", "state": "activated",
        "triggerAfterDriverStart": true,
        "trigger": { "action": "press", "scope": "document", "value": "Enter" },
        "triggerSequence": [
          { "action": "focus", "target": "a[href$='/docs/']" },
          { "action": "press", "scope": "document", "value": "Enter" }
        ],
        "commands": [{ "kind": "pause", "durationMs": 1000 }],
        "assertions": [
          { "type": "nodeMatches", "evidenceType": "accessibilityTree", "expected": { "role": "main" }, "minCount": 1, "maxCount": 1 },
          { "type": "nodeMatches", "evidenceType": "accessibilityTree", "expected": { "role": "heading", "level": 1 }, "minCount": 1 }
        ]
      }]
    },
    "HVE-NVDA-002": {
      "targetRefs": ["nav.topics", "nav.topics.firstItem"],
      "executions": [{
        "id": "hve-topics-menu", "title": "Topics menu exposes its first item",
        "route": "/hve-core/", "surfaceId": "homepage", "state": "open",
        "triggerAfterDriverStart": true,
        "trigger": { "action": "press", "scope": "document", "value": "Enter" },
        "triggerSequence": [
          { "action": "focus", "target": "[aria-controls='topics-menu']" },
          { "action": "press", "scope": "document", "value": "Enter" }
        ],
        "commands": [{ "kind": "pause", "durationMs": 500 }],
        "assertions": [
          { "type": "nodeMatches", "evidenceType": "accessibilityTree", "expected": { "role": "button", "name": "Topics", "expanded": true } },
          { "type": "nodeMatches", "evidenceType": "accessibilityTree", "expected": { "role": "link" }, "minCount": 1 }
        ]
      }, {
        "id": "hve-topics-menu-closed", "title": "Topics menu collapses under keyboard control",
        "route": "/hve-core/", "surfaceId": "homepage", "state": "closed",
        "triggerAfterDriverStart": true,
        "trigger": { "action": "press", "scope": "document", "value": "Escape" },
        "triggerSequence": [
          { "action": "focus", "target": "[aria-controls='topics-menu']" },
          { "action": "press", "scope": "document", "value": "Enter" },
          { "action": "press", "scope": "document", "value": "Escape" }
        ],
        "commands": [{ "kind": "pause", "durationMs": 500 }],
        "assertions": [
          { "type": "nodeMatches", "evidenceType": "accessibilityTree", "expected": { "role": "button", "name": "Topics", "expanded": false }, "minCount": 1, "maxCount": 1 }
        ]
      }]
    },
    "HVE-NVDA-003": {
      "targetRefs": ["search.seeAll"],
      "executions": [{
        "id": "hve-search-see-all-results", "title": "See all results is keyboard reachable from suggestions",
        "route": "/hve-core/", "surfaceId": "homepage", "state": "suggestions",
        "triggerAfterDriverStart": true,
        "trigger": { "action": "press", "scope": "document", "value": "ArrowDown" },
