    },
    "evidenceLimits": { "@id": "hve:evidenceLimits" },
    "toolVersion": { "@id": "hve:toolVersion" },
    "criteriaCatalog": { "@id": "hve:criteriaCatalog" },
    "quarantined": {
      "@id": "hve:quarantined",
      "@type": "http://www.w3.org/2001/XMLSchema#boolean"
    },
    "quarantineReason": { "@id": "hve:quarantineReason" },
    "method": { "@id": "hve:method" },
