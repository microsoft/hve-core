{
  "name": "docusaurus",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "test": "jest --verbose",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint:a11y": "eslint .",
    "lint:label-registry": "node scripts/check-label-registry.mjs",
    "serve:ci": "node e2e/static-server.mjs",
    "serve:preview": "docusaurus build && node e2e/static-server.mjs",
    "ci:test:e2e": "playwright test",
    "ci:test:e2e:fast": "playwright test --workers=4",
    "ci:test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-directive": "4.0.0",
    "remark-github-blockquote-alert": "2.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@happy-dom/jest-environment": "20.11.6",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/react": "19.2.18",
    "@typescript-eslint/parser": "8.67.0",
    "compression": "1.8.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-mdx": "3.8.1",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.4.2",
    "jest-axe": "11.0.0",
    "ts-jest": "29.4.12",
    "wait-on": "9.1.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "brace-expansion@^1": "1.1.18",
    "brace-expansion@^2": "2.1.4",
    "brace-expansion@^5": "5.0.9",
    "express": "5.2.1",
    "fast-uri": "3.1.5",
    "http-proxy-middleware": "2.0.10",
    "js-yaml@^3": "3.15.1",
    "js-yaml@^4": "4.3.1",
    "joi": "17.13.4",
    "minimatch@^3": "3.1.5",
    "minimatch@^10": "10.2.4",
    "nanoid": "3.3.18",
    "picomatch": "4.0.4",
    "postcss": "8.5.25",
    "serialize-javascript": "7.0.5",
    "shell-quote": "1.9.0",
    "svgo@^3": "3.3.4",
    "test-exclude": {
      "minimatch": "3.1.5"
    },
    "undici": "8.9.0",
    "uuid": "14.0.0",
    "webpack-dev-server": "5.2.6"
  }
