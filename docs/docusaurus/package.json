{
  "name": "docusaurus",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "npm run slides:sync && docusaurus start",
    "build": "npm run slides:sync && docusaurus build",
    "slides:sync": "node scripts/slide-bundles.cjs",
    "swizzle": "docusaurus swizzle",
    "deploy": "npm run slides:sync && docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "test": "jest --verbose && npm run test:mermaid-a11y",
    "test:coverage": "jest --coverage && npm run test:mermaid-a11y",
    "test:mermaid-a11y": "node --test scripts/validate-mermaid-accessibility.test.mjs && node scripts/validate-mermaid-accessibility.mjs",
    "typecheck": "tsc --noEmit",
    "lint:a11y": "eslint .",
    "lint:label-registry": "node scripts/check-label-registry.mjs",
    "serve:ci": "node e2e/static-server.mjs",
    "serve:preview": "npm run build && node e2e/static-server.mjs",
    "ci:test:e2e": "playwright test",
    "ci:test:e2e:fast": "playwright test --workers=4",
    "ci:test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "mermaid": "12.0.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-directive": "4.0.0",
    "remark-github-blockquote-alert": "2.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@happy-dom/jest-environment": "20.14.5",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/react": "19.3.0",
    "@typescript-eslint/parser": "8.71.0",
    "compression": "1.8.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-mdx": "3.8.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.2",
    "jest-axe": "11.0.0",
    "ts-jest": "29.4.14",
    "wait-on": "9.5.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^2": "2.1.7",
    "brace-expansion@^5": "5.0.12",
    "browserslist": "4.28.8",
    "dompurify": "3.4.16",
    "express": "5.2.1",
    "fast-uri": "3.1.8",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "http-proxy-middleware": "2.0.10",
    "image-size": "npm:image-size-next@2.1.1",
    "ip-address": "10.7.1",
    "js-yaml@^4": "4.3.2",
    "joi": "17.13.8",
    "lodash-es": "4.18.1",
    "minimatch@^3": "3.1.5",
    "minimatch@^10": "10.2.5",
    "nanoid": "3.3.18",
    "picomatch": "4.0.4",
    "postcss": "8.5.25",
    "postcss-selector-parser": "7.1.6",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "serialize-javascript": "7.0.5",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2",
    "svgo@^3": "3.3.5",
    "tinypool": "2.2.0",
    "undici": "8.10.2",
    "uuid": "14.0.0",
    "webpack-dev-middleware": "7.4.6",
    "webpack-dev-server": "5.2.6"
  }
}
