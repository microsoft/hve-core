# Node package manager configuration
#
# This project has its own package.json, so npm resolves "project" config from
# this directory and does not read the repository-root .npmrc. Registry and
# security settings must be repeated here to keep committed lockfiles publicly
# sourced and to keep install behavior aligned with the repository root.

# Keep committed lockfiles reproducible for OSS contributors.
registry=https://registry.npmjs.org/
replace-registry-host=always

# Save exact versions in package.json
save-exact=true

# Use package-lock.json for reproducible installs
package-lock=true

# Do not run lifecycle scripts (preinstall/install/postinstall) from dependencies
ignore-scripts=true
