# Keep the nested publisher toolchain reproducible for OSS contributors.
registry=https://registry.npmjs.org/
replace-registry-host=always

save-exact=true
package-lock=true
audit=true
audit-level=moderate

# Lifecycle scripts stay off by default. The unprivileged preparation job
# enables them explicitly because vsce requires its native install hooks.
ignore-scripts=true
engine-strict=false
