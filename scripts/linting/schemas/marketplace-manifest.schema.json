{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Marketplace Manifest",
  "description": "Schema for hve-core Copilot CLI marketplace.json plugin manifest",
  "type": "object",
  "definitions": {
    "componentPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
      "not": {
        "pattern": "(^|/)\\.\\.?(/|$)"
      },
      "description": "Package-relative forward-slash path. Absolute paths, backslashes, empty segments, and relative or escaping segments are rejected."
    },
    "componentMembership": {
      "oneOf": [
        {
          "$ref": "#/definitions/componentPath"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/componentPath"
          }
        }
      ],
      "description": "Standard component membership: one package-relative path or an array of them."
    },
    "maturity": {
      "type": "string",
      "enum": [
        "stable",
        "preview",
        "experimental",
        "deprecated",
        "removed"
      ]
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        }
      },
      "additionalProperties": false
    },
    "objectSource": {
      "type": "object",
      "required": [
        "source",
        "repo",
        "path",
        "ref"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "github"
          ],
          "description": "GitHub repository locator type."
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
          "description": "Repository locator in owner/name form. Required for github sources."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          },
          "description": "Repository-relative package path."
        },
        "ref": {
          "type": "string",
          "pattern": "^plugins-v\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
          "description": "Immutable plugins-v<version> tag."
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "metadata",
    "owner",
    "plugins"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Repository name used as the marketplace identifier."
    },
    "metadata": {
      "type": "object",
      "required": [
        "description",
        "version",
        "pluginRoot"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Short description of the marketplace."
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+",
          "description": "Semantic version string from package.json."
        },
        "pluginRoot": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the plugins directory."
        }
      },
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Organization or individual owning the repository."
        }
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "description": "Content recipes that own the distributable components. One or many ordinary entries are supported.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source",
          "description",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Plugin identifier. Lowercase letters, digits, and hyphens only."
          },
          "source": {
            "$ref": "#/definitions/objectSource",
            "description": "Immutable GitHub package locator."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Short description of the plugin."
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+",
            "description": "Semantic version string matching the marketplace version."
          },
          "author": {
            "$ref": "#/definitions/author"
          },
          "homepage": {
            "type": "string",
            "pattern": "^https://\\S+$"
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "strict": {
            "type": "boolean"
          },
          "agents": {
            "$ref": "#/definitions/componentMembership"
          },
          "commands": {
            "$ref": "#/definitions/componentMembership",
            "description": "Prompt component membership."
          },
          "rules": {
            "$ref": "#/definitions/componentMembership",
            "description": "Instruction component membership."
          },
          "skills": {
            "$ref": "#/definitions/componentMembership"
          },
          "hooks": {
            "$ref": "#/definitions/componentPath",
            "description": "Single hooks configuration path."
          },
          "x-hve": {
            "type": "object",
            "description": "Entry-level metadata overlay. Never owns component membership and never appears in a generated root plugin.json.",
            "required": [
              "displayName"
            ],
            "properties": {
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "maturity": {
                "$ref": "#/definitions/maturity"
              },
              "componentMaturity": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/definitions/componentPath"
                },
                "additionalProperties": {
                  "$ref": "#/definitions/maturity"
                },
                "description": "Per-component maturity keyed by normalized standard component path. Removed tombstones may be absent from active membership."
              },
              "documentation": {
                "$ref": "#/definitions/componentPath"
              },
              "profiles": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z0-9-]+$"
                },
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/definitions/componentPath"
                  }
                },
                "description": "Named selection profiles. Every profile path must also appear in entry membership; profiles never define distribution membership."
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
