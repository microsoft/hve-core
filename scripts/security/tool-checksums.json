    {
      "name": "copilot-cli",
      "repo": "github/copilot-cli",
      "version": "1.0.87",
      "verification": "published-checksums",
      "sha256": "49d81b184f1a1b358af676155fe97e341b9d9f0bc8dd25190dfe17087669b5b9",
      "sha256ByArch": {
        "linux_amd64": "49d81b184f1a1b358af676155fe97e341b9d9f0bc8dd25190dfe17087669b5b9",
