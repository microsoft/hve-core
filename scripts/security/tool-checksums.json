    {
      "name": "piper",
      "repo": "OHF-voice/piper1-gpl",
      "version": "1.8.0",
      "verification": "pypi",
      "envPrefix": "PIPER",
      "registry": "pypi",
      "package": "piper-tts",
      "lockProject": "scripts/tools/piper",
      "sha256ByArch": {
        "linux_amd64": "25b4d3f31ff70c8fa7151908e00aaa5650cbdf16bca8fcf21299f3941b89a7d3",
