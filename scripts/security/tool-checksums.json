      },
      "notes": "VS Code CLI for demo-material-render.yml, downloaded by commit. The checksum is the sha256hash published by the VS Code update API for that commit."
    },
    {
      "name": "gh-aw-firewall",
      "repo": "github/gh-aw-firewall",
      "version": "0.29.0",
      "verification": "oci-digest",
      "images": {
        "agent": "sha256:b14bd399376180b5649a9324be3b50fbfc82bfe8f0c80045840416b5a4e65b96",
        "api-proxy": "sha256:baff00b856a4bdc93bce134928c70af3d3492f2e518757115042040674d56b0b",
        "squid": "sha256:6e0cbf7f980beb78b5461563a8164f6439ca959bc93733d5a6b52972e523ed50"
      },
      "notes": "Agent workflow firewall (AWF) images that the gh-aw compiler pins by digest in every *.lock.yml."
    }
  ],
  "psModules": [
    {
      "name": "PowerShell-Yaml",
      "version": "0.4.7",
      "notes": "YAML parser used by workflow, frontmatter, and artifact metadata validation; pinned to known-good stable per ADR in docs/security/dependency-pinning.md"
    },
    {
      "name": "Pester",
      "version": "6.2.0",
      "notes": "PowerShell test framework; scripts/tests/Invoke-PesterTests.ps1 imports this exact version from scripts/security/ps-module-versions.json"
    },
    {
      "name": "PSScriptAnalyzer",
      "version": "1.25.0",
      "notes": "PowerShell linter used by lint:ps; pinned for reproducible analysis results across CI and devcontainer"
    }
  ]
}
