  ],
  "psModules": [
    {
      "name": "PowerShell-Yaml",
      "version": "0.4.7",
      "notes": "YAML parser used by workflow, frontmatter, and artifact metadata validation; pinned to known-good stable per ADR in docs/security/dependency-pinning.md"
    },
    {
      "name": "Pester",
      "version": "5.7.1",
      "notes": "PowerShell test framework; required by all *.Tests.ps1 files via #Requires -Modules @{ ModuleName='Pester'; RequiredVersion='5.7.1' }"
    },
    {
      "name": "PSScriptAnalyzer",
      "version": "1.25.0",
      "notes": "PowerShell linter used by lint:ps; pinned for reproducible analysis results across CI and devcontainer"
    }
  ]
}
