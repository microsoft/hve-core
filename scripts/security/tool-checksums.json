      "assetTemplateByArch": {
        "linux_amd64": "https://github.com/google/osv-scanner/releases/download/v{version}/osv-scanner_linux_amd64",
        "linux_arm64": "https://github.com/google/osv-scanner/releases/download/v{version}/osv-scanner_linux_arm64"
      },
      "notes": "Vulnerability scanning in the devcontainer, Copilot setup steps, and vex-detect.yml. Checksums from osv-scanner_SHA256SUMS."
    },
    {
      "name": "uv",
      "repo": "astral-sh/uv",
      "version": "0.13.6",
      "verification": "published-checksums",
      "envPrefix": "UV",
      "sha256": "f29c3e94ffabd7e6f3ba521dba169a9b7ec12100bf3257087f0f24f6123f3645",
      "sha256ByArch": {
        "linux_amd64": "f29c3e94ffabd7e6f3ba521dba169a9b7ec12100bf3257087f0f24f6123f3645",
        "linux_arm64": "229e194255c7958d86d56e8790d969a6f74736592133f0dfd0076f754c642c1d"
      },
      "assetTemplateByArch": {
        "linux_amd64": "https://github.com/astral-sh/uv/releases/download/{version}/uv-x86_64-unknown-linux-gnu.tar.gz",
        "linux_arm64": "https://github.com/astral-sh/uv/releases/download/{version}/uv-aarch64-unknown-linux-gnu.tar.gz"
      },
      "notes": "Python package manager for the devcontainer, Copilot setup steps, and every workflow uv install. Checksums from the per-asset .sha256 files; release tags have no v prefix."
    },
    {
      "name": "shellcheck",
      "repo": "koalaman/shellcheck",
      "version": "0.11.0",
      "verification": "release-digest",
      "envPrefix": "SHELLCHECK",
      "sha256": "8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198",
      "sha256ByArch": {
        "linux_amd64": "8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198",
        "linux_arm64": "12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588"
      },
      "assetTemplateByArch": {
        "linux_amd64": "https://github.com/koalaman/shellcheck/releases/download/v{version}/shellcheck-v{version}.linux.x86_64.tar.xz",
        "linux_arm64": "https://github.com/koalaman/shellcheck/releases/download/v{version}/shellcheck-v{version}.linux.aarch64.tar.xz"
      },
      "notes": "Shell script analysis for workflow validation. The project publishes no checksum file or attestation; digests are the GitHub release asset digests recorded at registration."
    },
    {
      "name": "zizmor",
      "repo": "zizmorcore/zizmor",
      "version": "1.30.1",
      "verification": "attestation",
      "envPrefix": "ZIZMOR",
      "sha256": "e65324f4430c2717591937edcec90ccbefaf14c174f8ec9415e03ca875b46e1a",
      "sha256ByArch": {
        "linux_amd64": "e65324f4430c2717591937edcec90ccbefaf14c174f8ec9415e03ca875b46e1a",
        "linux_arm64": "7ff1dce33bdd18fd2a4affe63bdd47efcccca97b2cec1c1863ec26e9e2647540"
      },
      "assetTemplateByArch": {
        "linux_amd64": "https://github.com/zizmorcore/zizmor/releases/download/v{version}/zizmor-x86_64-unknown-linux-gnu.tar.gz",
        "linux_arm64": "https://github.com/zizmorcore/zizmor/releases/download/v{version}/zizmor-aarch64-unknown-linux-gnu.tar.gz"
      },
      "attestation": {
        "repo": "zizmorcore/zizmor",
        "signerWorkflow": ".github/workflows/release-binaries.yml"
      },
      "notes": "GitHub Actions static analysis. No checksum file is published; digests verified with gh attestation verify."
    },
    {
      "name": "gh-aw",
      "repo": "github/gh-aw",
      "version": "1.0.1",
      "verification": "published-checksums",
      "envPrefix": "GH_AW",
      "sha256": "746d0b41d5fb87e2c010b8ac23a464436bb745ff89fbd19a3456431942c37652",
      "sha256ByArch": {
        "linux_amd64": "746d0b41d5fb87e2c010b8ac23a464436bb745ff89fbd19a3456431942c37652",
        "linux_arm64": "84a3fb897ec6f6ec698bd160cf8ef8700fd147278e239ad626bd0ec32c3baed2"
      },
      "assetTemplateByArch": {
        "linux_amd64": "https://github.com/github/gh-aw/releases/download/v{version}/linux-amd64",
        "linux_arm64": "https://github.com/github/gh-aw/releases/download/v{version}/linux-arm64"
      },
      "notes": "Agentic workflow compiler. Every compiled *.lock.yml records this compiler_version. Checksums from checksums.txt."
    },
    {
      "name": "copilot-cli",
      "repo": "github/copilot-cli",
      "version": "1.0.103",
      "verification": "published-checksums",
      "sha256": "9aeb4430e9ac9523546db07b227c7aba179a4710a55f9ac29ad143b0f9e1b325",
      "sha256ByArch": {
        "linux_amd64": "9aeb4430e9ac9523546db07b227c7aba179a4710a55f9ac29ad143b0f9e1b325",
        "linux_arm64": "728a91dffb9a02817bd98c5b01bf2f9cb08c4fdac3c0ca8c48d7f1ccbfe282a1"
      },
      "assetTemplateByArch": {
        "linux_amd64": "https://github.com/github/copilot-cli/releases/download/v{version}/copilot-linux-x64.tar.gz",
        "linux_arm64": "https://github.com/github/copilot-cli/releases/download/v{version}/copilot-linux-arm64.tar.gz"
      },
      "notes": "Copilot CLI that gh-aw installs for the agent. Every agentic workflow source pins engine.version to this version, and each compiled *.lock.yml passes it to install_copilot_cli.sh, which verifies the tarball against SHA256SUMS.txt. Checksums from SHA256SUMS.txt."
    },    {
      "name": "gh-actions-lock",
      "repo": "github/gh-actions-lock",
      "version": "0.1.6",
      "verification": "attestation",
      "envPrefix": "GH_ACTIONS_LOCK",
      "sha256": "4181ec1da5408b34b9a542a7ee5c6ce3a4d6ac815c7d0206a00ceca8a817f4e3",
      "sha256ByArch": {
        "linux_amd64": "4181ec1da5408b34b9a542a7ee5c6ce3a4d6ac815c7d0206a00ceca8a817f4e3",
        "linux_arm64": "31c99e586f8f5fa2607ea79af74e3b50bc7ed4be1580a0d8449cdd73d1aba5e4"
