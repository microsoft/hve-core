      "sha256ByArch": {
        "linux_amd64": "db15cc99e6e4837daabab023742aaddc3841ce57f193d11b7c3e06c8003642b2",
        "linux_arm64": "d098f3168ae4b3aa70b4ca78947329b953272b487727d1722cb3cb098a1a20ab"
      },
      "assetTemplateByArch": {
        "linux_amd64": "https://github.com/sigstore/cosign/releases/download/v{version}/cosign-linux-amd64",
        "linux_arm64": "https://github.com/sigstore/cosign/releases/download/v{version}/cosign-linux-arm64"
      },
      "notes": "Artifact signing in the devcontainer and Copilot setup steps. Checksums from cosign_checksums.txt."
    },
    {
