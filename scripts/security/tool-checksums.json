{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Single source of truth for downloaded tool versions and checksums. Test-ToolVersionConsistency.ps1 fails when a hard-coded copy disagrees, and Test-SHAStaleness.ps1 reports newer releases.",
  "tools": [
    {
      "name": "gitleaks",
      "repo": "gitleaks/gitleaks",
      "version": "8.30.0",
      "verification": "published-checksums",
      "envPrefix": "GITLEAKS",
      "sha256": "79a3ab579b53f71efd634f3aaf7e04a0fa0cf206b7ed434638d1547a2470a66e",
      "sha256ByArch": {
        "linux_amd64": "79a3ab579b53f71efd634f3aaf7e04a0fa0cf206b7ed434638d1547a2470a66e",
        "linux_arm64": "b4cbbb6ddf7d1b2a603088cd03a4e3f7ce48ee7fd449b51f7de6ee2906f5fa2f"
      },
      "assetTemplateByArch": {
        "linux_amd64": "https://github.com/gitleaks/gitleaks/releases/download/v{version}/gitleaks_{version}_linux_x64.tar.gz",
        "linux_arm64": "https://github.com/gitleaks/gitleaks/releases/download/v{version}/gitleaks_{version}_linux_arm64.tar.gz"
      },
      "notes": "Secret scanning in the devcontainer and gitleaks-scan.yml. The vendor names the linux amd64 asset 'linux_x64'."
    },
    {
      "name": "cosign",
      "repo": "sigstore/cosign",
      "version": "3.0.5",
      "verification": "published-checksums",
      "envPrefix": "COSIGN",
